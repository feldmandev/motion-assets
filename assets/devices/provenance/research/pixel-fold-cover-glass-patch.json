  "coordinate_convention": {
    "profiles": "screens[cover].glass_outline_mm contains offsets from that cover screen center_mm, in parent panel X/Y axes (millimetres, +Y up). geometry.slab translates by screen center; it does not rotate these points. Unfolded profiles store X mirrored once, Y unchanged.",
    "closed_trace": "glass_outline_mm uses the same screen-center-relative +X-right/+Y-up convention as the folded profile. Add trace.screen_rect_mm[:2] to obtain source body-center coordinates. No body normalization, OLED expansion or OLED fitting is applied to the glass.",
    "pixel_sources": "Original uncropped SDK back.webp pixels, origin top-left. Polygon coordinates refer to selected pixel centers; antialias/interface width limits precision."
  },
  "method": {
    "source_resolution": "Native SDK back.webp, not the small frame.webp thumbnail and not stale front.png.",
    "candidate": "Original Fold: opaque neutral-color pixels (RGB max-min <=4). 9 Pro Fold: opaque RGB max <=42, to include its dark-gray glass but exclude gray metal. 10 Pro Fold: opaque neutral-color pixels (RGB max-min <=5), preserving glass highlights. Add alpha-clear OLED viewport, clip to earlier independent straight metal/glass stations, 7x7 closing, fill holes, keep largest contour, 3x3 opening, 1.2 px polygon simplification.",
    "manual_boundary_corrections": "Remove antenna-band/hinge contamination on straight segments. Inspect native top/bottom crops. Digitize shallow speaker recess from its visible interface. Original Fold straight top revised from earlier y20 joint/interface estimate to y25 reflected-glass edge; free side x1236 and bottom2208 remain inside earlier x1240/y2212 interface estimates. 9 Fold bottom seam spur removed and straight base set y2527. These are source-boundary estimates, not pixel-perfect manufactured contours.",
    "not_used": "No OLED dilation or body-outline anisotropic inset for official 1/9/10 cover-glass contours. No classification of the whole dark rail as glass.",
    "visual_evidence_local": "tmp/pixel-fold-cover-glass/*-final-top.png and *-final-bottom.png; local research overlays only, not publication assets."
  },
